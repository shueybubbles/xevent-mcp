{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "description": "Expose SQL Server extended events from files and session targets",
  "name": "io.github.shueybubbles/xe-mcp",
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org",
      "identifier": "Bubbles.XEvent.MCPServer",
      "version": "0.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [],
      "environmentVariables": [
        {
          "name": "CONNECTION_STRING",
          "value": "{connection_string}",
          "variables": {
            "connection_string": {
              "description": "ADO.Net connection string to connect to the server. Defaults to localhost/Windows authentication.",
              "isRequired": true,
              "isSecret": false
            }
          }
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/shueybubbles/xe-mcp",
    "source": "github"
  }
}